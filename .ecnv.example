# ─────────────────────────────────────────────────────────────
# AgentzProof — GenLayer contract environment (root)
# Copy to `.env` when deploying the Intelligent Contract.
# ─────────────────────────────────────────────────────────────

# GenLayer network: localnet | studionet | testnetAsimov | testnetBradbury
GENLAYER_NETWORK=testnetBradbury

# RPC endpoint for the deployed Bradbury contract (chain ID 4221)
GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# Deployed AgentzProofVerifier contract on Bradbury
GENLAYER_CONTRACT_ADDRESS=0xbe1de3345603162554fcdff2b75cf4aa96c74329

# Private key used by the app's server-side wallet to submit verification
# transactions (hex, 0x-prefixed). NEVER commit this; never expose it to the
# client. Leave empty to skip on-chain verification (DEMO MODE).
GENLAYER_PRIVATE_KEY=

# Optional: where the app persists verifications (JSON file, relative to frontend/)
# DATA_FILE=data/verifications.json

# Optional: set when running the frontend directly from a monorepo context
# NEXT_PUBLIC_APP_URL=https://agentzproof.xyz
